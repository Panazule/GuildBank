# Copy to .env only for local development; never commit .env.
# Flags override these values, which override the built-in defaults.

GUILDBANK_PORT=8080
GUILDBANK_SQLITE_PATH=/config/guildbank.db
GUILDBANK_LOG_LEVEL=info
GUILDBANK_LOG_FORMAT=json
# Set true when the application is served over HTTPS.
GUILDBANK_SECURE_COOKIES=false
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-* headers.
GUILDBANK_TRUSTED_PROXIES=

# Development bootstrap only. The setup wizard persists credentials in SQLite,
# but Phase 3 adopts Settings for the live pool (PD-18).
GUILDBANK_MARIADB_HOST=
GUILDBANK_MARIADB_PORT=3306
GUILDBANK_MARIADB_DATABASE=GuildBank
GUILDBANK_MARIADB_USERNAME=
GUILDBANK_MARIADB_PASSWORD=